# Telegram Bot Token — lấy từ @BotFather
TG_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxx

# Telegram Forum Group ID (số âm, ví dụ: -1001234567890)
# Bot phải là admin của group này, và group phải bật Topics
TG_GROUP_ID=-1001234567890

# Telegram user IDs allowed to control the bridge (comma-separated)
# Only these users can run commands or forward Telegram messages to Zalo.
ADMIN_USER_IDS=1162173490

# Đường dẫn tới file credentials Zalo
ZALO_CREDENTIALS_PATH=./credentials.json

# Thư mục lưu dữ liệu persistent
DATA_DIR=./data

# Facebook video downloads dùng persistent Chrome profile (không còn export cookie JSON tay).
# Login 1 lần: node scripts/login-facebook-profile.mjs (headed, thấy trình duyệt thật, đăng nhập tay).
# FB_PROFILE_DIR   — nơi lưu profile Chrome (default: ./data/fb-profile)
# FB_COOKIES_PATH  — file cookie Netscape cho yt-dlp, tự sinh từ profile (default: ./data/facebook-cookies.txt)
# yt-dlp tự update + canary health-check mỗi 6 giờ (chỉ cảnh báo khi vẫn fail sau update).
# YTDLP_BIN       — override binary yt-dlp (default: Python311 user Scripts path nếu tồn tại)
# PIP_BIN         — override pip dùng để update (mặc định pip.exe cạnh YTDLP_BIN)
# YTDLP_CANARY_URL — URL YouTube public dùng làm extraction canary
# YTDLP_CHECK_INTERVAL_MS — chu kỳ watchdog milliseconds (default: 21600000)
